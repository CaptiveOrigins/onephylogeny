{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the OnePhylogeny window may do",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "/Volumes/**"
        },
        {
          "path": "$RESOURCE/resources/**"
        }
      ]
    },
    "store:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://eutils.ncbi.nlm.nih.gov/*"
        },
        {
          "url": "https://www.ebi.ac.uk/europepmc/*"
        },
        {
          "url": "https://api.crossref.org/works*"
        },
        {
          "url": "https://api.ncbi.nlm.nih.gov/datasets/v2/*"
        },
        {
          "url": "https://api.gbif.org/v1/*"
        },
        {
          "url": "https://search.idigbio.org/v2/*"
        },
        {
          "url": "https://portal.boldsystems.org/api/*"
        }
      ]
    },
    "process:allow-restart",
    "updater:default"
  ]
}