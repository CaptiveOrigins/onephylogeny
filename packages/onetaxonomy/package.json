{
  "name": "@extantape/onephylogeny-onetaxonomy",
  "version": "0.1.0-alpha.8",
  "description": "Optional bridge from OnePhylogeny to OneTaxonomy: exports finished trees as Phylogeny records, with their support values and explicit taxon mappings.",
  "keywords": [
    "phylogenetics",
    "reference-panel"
  ],
  "homepage": "https://github.com/ExtantApe/OnePhylogeny#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/OnePhylogeny/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/OnePhylogeny.git",
    "directory": "packages/onetaxonomy"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@extantape/onephylogeny-core": "workspace:^"
  },
  "peerDependencies": {
    "@extantape/onetaxonomy-core": "^0.1.0-alpha.4",
    "@extantape/onetaxonomy-import": "^0.1.0-alpha.4"
  },
  "devDependencies": {
    "@extantape/onetaxonomy-core": "^0.1.0-alpha.4",
    "@extantape/onetaxonomy-import": "^0.1.0-alpha.4"
  }
}
