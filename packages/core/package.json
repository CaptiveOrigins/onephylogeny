{
  "name": "@captiveorigins/onephylogeny-core",
  "version": "0.1.0-alpha.0",
  "description": "OnePhylogeny core: sequence records, GenBank and FASTA parsing, reference coordinates, coverage-aware comparison and haplotypes, frame checks, profiles and record sheets. Species-agnostic, with no React, CMS, database or platform dependency.",
  "keywords": ["phylogenetics", "haplotype", "genbank", "fasta", "mitochondrial-dna"],
  "homepage": "https://github.com/mgilardi/onephylogeny#readme",
  "bugs": { "url": "https://github.com/mgilardi/onephylogeny/issues" },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": { "type": "git", "url": "git+https://github.com/mgilardi/onephylogeny.git", "directory": "packages/core" },
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  }
}
