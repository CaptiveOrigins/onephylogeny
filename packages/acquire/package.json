{
  "name": "@extantape/onephylogeny-acquire",
  "version": "0.1.0-alpha.8",
  "description": "OnePhylogeny acquire: fetches sequence records by taxon and marker with safe retries and no duplicates, keeps raw files with hashes, and suggests outgroups outward through the taxonomy.",
  "keywords": [
    "phylogenetics",
    "reference-panel",
    "genbank"
  ],
  "homepage": "https://github.com/ExtantApe/OnePhylogeny#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/OnePhylogeny/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/OnePhylogeny.git",
    "directory": "packages/acquire"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@extantape/onephylogeny-core": "workspace:^"
  }
}
