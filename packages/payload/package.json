{
  "name": "@captiveorigins/payload-plugin-onephylogeny",
  "version": "0.1.0-alpha.6",
  "description": "OnePhylogeny for Payload: immutable reference panels and released results on your own collections, with server-enforced review, safe endpoints and no coordinates.",
  "keywords": [
    "phylogenetics",
    "reference-panel"
  ],
  "homepage": "https://github.com/CaptiveOrigins/onephylogeny#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/onephylogeny/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/onephylogeny.git",
    "directory": "packages/payload"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@captiveorigins/onephylogeny-core": "workspace:^"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "^3.92.1",
    "@types/node": "^24.19.2"
  }
}
